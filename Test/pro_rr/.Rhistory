library(Rcpp)
library(ProCESS)
sourceCpp("src/rr_sim.cpp")
library(Rcpp)
library(ProCESS)
#sourceCpp("src/rr_sim.cpp")
sim <- TissueSimulation()
sim$add_mutant(name = "A", growth_rates = 0.1, death_rates = 0.01)
sim$place_cell("A", 500, 500)
sim$run_up_to_size("A", 1000)
plot_tissue(sim)
sim$sample_cells("S_1_1", bottom_left = c(500, 500),
top_right = c(502, 502))
plot_tissue(sim)
forest <- sim$get_sample_forest()
plot_forest(forest)
#test_roadrunner()
