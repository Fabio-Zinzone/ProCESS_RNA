library(Rcpp)
library(dplyr)
library(ProCESS)
#sourceCpp("src/rr_sim.cpp")
sim <- TissueSimulation()
sim$add_mutant(name = "A", growth_rates = 0.5, death_rates = 0.01)
sim$place_cell("A", 500, 500)
sim$run_up_to_size("A", 10000)
plot_tissue(sim)
sim$sample_cells("S", bottom_left = c(500, 500),
top_right = c(540, 525))
plot_tissue(sim)
forest <- sim$get_sample_forest()
forest$get_nodes() %>% head
forest$get_nodes() %>%
filter(!is.na(.data$sample)) %>%
head
forest$get_nodes() %>%
filter(is.na(.data$ancestor))
forest$get_samples_info()
plot_forest(forest)
#test_roadrunner()
library(Rcpp)
library(dplyr)
library(ProCESS)
#sourceCpp("src/rr_sim.cpp")
start_time <- Sys.time()
set.seed(0)
sim <- TissueSimulation()
sim$add_mutant(name = "A", growth_rates = 0.5, death_rates = 0.01)
sim$place_cell("A", 500, 500)
sim$run_up_to_size("A", 10000)
plot_tissue(sim)
sim$sample_cells("S", num_of_cells = 1000)
plot_tissue(sim)
forest <- sim$get_sample_forest()
forest$get_nodes() %>% head
forest$get_nodes() %>%
filter(!is.na(.data$sample)) %>%
head
forest$get_nodes() %>%
filter(is.na(.data$ancestor))
forest$get_samples_info()
plot_forest(forest)
#test_roadrunner()
end_time <- Sys.time()
delta_time <- end_time - start_time
print(delta_time)
